# Copy to .env. The defaults match docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://dcms:dcms@localhost:5433/dcms

# Signs the session cookie. Generate a real one for the office server:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-change-me

DEBUG=true

# Comma-separated origins allowed to make credentialed requests to the API
# directly (not through the Next.js proxy). Add the Vercel URL in production,
# e.g. ALLOWED_ORIGINS=http://localhost:3000,https://dcms-friend.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
