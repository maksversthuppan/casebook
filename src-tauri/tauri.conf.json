{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Casebook",
  "version": "0.1.0",
  "identifier": "in.reflectionsinfos.casebook",
  "build": {
    "frontendDist": "dist-stub"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend": "backend",
      "resources/frontend": "frontend"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
